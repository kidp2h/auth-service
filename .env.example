# Application Configuration
PORT=3000
AUTH_GRPC_URL=0.0.0.0:50051

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@auth-postgres:5432/auth_db
DATABASE_SSL=false
POSTGRES_DB=auth_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=auth-redis
REDIS_PORT=6379

# Security & External Services
JWT_SECRET=dev_jwt_secret_key_12345
PROFILE_SERVICE_URL=host.docker.internal:15051

# Token signing. Preferred: RS256, public keys are published at
# GET /auth/.well-known/jwks.json so other services verify tokens locally.
# Generate with: openssl genrsa 2048   (newlines may be written as \n)
# JWT_PRIVATE_KEY=
# JWT_KEY_ID=                    # optional, defaults to a thumbprint of the key
# JWT_PREVIOUS_PUBLIC_KEY=       # key rotation: keep the old public key until old tokens expire
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800
# Login throttling (failed attempts per window)
# LOGIN_MAX_FAILURES_PER_EMAIL=5
# LOGIN_MAX_FAILURES_PER_IP=50
# LOGIN_LOCK_SECONDS=900

# Profile creation on register: grpc (synchronous, default) or event
# (transactional outbox -> Kafka topic account.created).
# PROFILE_SYNC_MODE=grpc
# PROFILE_GRPC_DEADLINE_MS=2000
# KAFKA_BROKERS=kafka:9092       # required when PROFILE_SYNC_MODE=event

# Observability. Tracing is enabled only when an OTLP endpoint is set.
# METRICS_PORT=9100              # Prometheus, internal port (never routed by the Ingress)
# LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=auth-service
