# ==============================================================================
# Local GitHub Actions (act) Secrets Configuration
# ==============================================================================
# Copy this file to .secrets and replace with your actual credentials:
# cp .secrets.example .secrets
# ==============================================================================

# Docker Hub Credentials (for CD container build & publish)
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_access_token

# GitHub Personal Access Token (PAT) with repo write permissions (for checkout & GitOps dispatch)
GITOPS_PAT_TOKEN=ghp_your_personal_access_token
